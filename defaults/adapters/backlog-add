#!/bin/sh
set -eu

TODOS_FILE="${NOODLE_TODOS_FILE:-todos.md}"
mkdir -p "$(dirname "$TODOS_FILE")"
[ -f "$TODOS_FILE" ] || {
  cat > "$TODOS_FILE" <<'INIT'
# Todos

<!-- next-id: 1 -->

## Inbox
INIT
}

# Prints the string value of key $2 in JSON object $1, unescaped and on one
# line: \" and \\ decode, \n and \t become spaces so an item stays one line.
json_field() {
  printf '%s' "$1" | awk -v key="$2" '
    { s = s $0 }
    END {
      if (!match(s, "\"" key "\"[ \t]*:[ \t]*\"")) exit
      rest = substr(s, RSTART + RLENGTH)
      out = ""
      for (i = 1; i <= length(rest); i++) {
        c = substr(rest, i, 1)
        if (c == "\\") {
          i++
          c = substr(rest, i, 1)
          if (c == "n" || c == "t") c = " "
        } else if (c == "\"") {
          break
        }
        out = out c
      }
      printf "%s", out
    }'
}

payload=$(cat)
title=$(json_field "$payload" title)
section=$(json_field "$payload" section)
[ -n "$title" ] || { echo "title required" >&2; exit 1; }
[ -n "$section" ] || section="Inbox"

next_id=$(sed -n 's/.*next-id:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$TODOS_FILE" | head -n1)
if [ -z "$next_id" ]; then
  max_id=$(sed -n 's/^\([0-9][0-9]*\)\..*/\1/p' "$TODOS_FILE" | sort -n | tail -n1)
  [ -n "$max_id" ] || max_id=0
  next_id=$((max_id + 1))
fi

# Insert after the last item in the section, before the next "## " header, so
# the item lands in its section rather than at the end of the file. A missing
# section is appended.
tmp="$TODOS_FILE.tmp"
NOODLE_SECTION="## $section" NOODLE_LINE="$next_id. [ ] $title" awk '
  BEGIN { header = ENVIRON["NOODLE_SECTION"]; line = ENVIRON["NOODLE_LINE"] }
  { lines[NR] = $0 }
  END {
    start = 0
    for (i = 1; i <= NR; i++) if (lines[i] == header) { start = i; break }
    if (start == 0) {
      for (i = 1; i <= NR; i++) print lines[i]
      print ""
      print header
      print line
      exit
    }
    last = start
    for (i = start + 1; i <= NR && lines[i] !~ /^## /; i++) if (lines[i] != "") last = i
    for (i = 1; i <= NR; i++) {
      print lines[i]
      if (i == last) print line
    }
  }' "$TODOS_FILE" > "$tmp"
mv "$tmp" "$TODOS_FILE"

next_next=$((next_id + 1))
if grep -q 'next-id:' "$TODOS_FILE"; then
  tmp="$TODOS_FILE.tmp"
  sed "s/next-id:[[:space:]]*[0-9][0-9]*/next-id: $next_next/" "$TODOS_FILE" > "$tmp"
  mv "$tmp" "$TODOS_FILE"
else
  tmp="$TODOS_FILE.tmp"
  awk -v n="$next_next" 'NR==2{print ""; print "<!-- next-id: " n " -->"} {print}' "$TODOS_FILE" > "$tmp"
  mv "$tmp" "$TODOS_FILE"
fi

echo "$next_id"
